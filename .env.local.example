# ─────────────────────────────────────────
# Database
# ─────────────────────────────────────────
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster.mongodb.net/YOUR_DB

# ─────────────────────────────────────────
# Auth JWT
# ─────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_min_32_chars

# ─────────────────────────────────────────
# Cloudinary (Image Upload)
# Get from: https://cloudinary.com/console
# NEVER expose API_SECRET in frontend code
# ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─────────────────────────────────────────
# App Base URL
# ─────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─────────────────────────────────────────
# Google Drive Picker API (Optional - for future Google Picker integration)
# Get from: https://console.cloud.google.com/
# Steps:
#   1. Create a project in Google Cloud Console
#   2. Enable: Google Drive API + Google Picker API
#   3. Create OAuth 2.0 Client ID (Web Application type)
#   4. Under "Authorized JavaScript origins" add: http://localhost:3000
#   5. Under "Authorized redirect URIs" add: http://localhost:3000
#   6. Create an API Key (restrict to: Picker API + Drive API)
# NOTE: Currently using "Paste Google Drive Link" method which works without OAuth
# ─────────────────────────────────────────
# NEXT_PUBLIC_GOOGLE_API_KEY=your_google_api_key
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
